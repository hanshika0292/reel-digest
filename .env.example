# Copy to instagram_dm_mcp/.env: the MCP server and login_once.py read it from that folder. Keep it chmod 600.
# login_once.py creates this file for you if it is missing.

# Instagram account that is a member of the DM group; also names the saved session file (<username>_session.json).
INSTAGRAM_USERNAME=your_instagram_username
# Instagram password. The MCP server refuses to start without it; `login_once.py --password` logs in with it.
INSTAGRAM_PASSWORD=your_instagram_password
